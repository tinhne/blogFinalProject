# --- Database -------------------------------------------------------------
# Local run against the docker-compose "database" service (host port 5434):
DATABASE_URL="postgresql://your-db-user:your-db-password@localhost:5434/your-db-name"
# Inside docker-compose, point at the service name instead:
# DATABASE_URL="postgresql://your-db-user:your-db-password@database:5432/your-db-name"

# Read by the postgres:15 container (docker-compose env_file)
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=your-db-name

# --- Auth -----------------------------------------------------------------
JWT_SECRET=your-long-random-secret
ACCESS_TOKEN_EXPIRY=2h
REFRESH_TOKEN_EXPIRY=7d
RATE_LIMIT_MAX=100

# --- Email (Nodemailer SMTP) ----------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@example.com
# Base URL used to build the verification link in emails
FRONTEND_URL=http://localhost:3000

# --- Uploads --------------------------------------------------------------
# Public base URL prepended to uploaded file paths (/public/...)
BASE_URL=http://localhost:3000

# AWS S3 client is configured in src/config/aws.ts but not used by the upload flow yet
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name

NODE_ENV=development
